name = "the-ark-spa-api"
main = "worker.js"
compatibility_date = "2026-10-10"
workers_dev = true

[observability]
enabled = true

[[d1_databases]]
binding = "DB"
database_name = "thearkspadata"
database_id = "4078fc56-d0c4-4748-b5d7-a8c4dcfd3d85"
migrations_dir = "migrations"

# R2 must be enabled and this bucket created before binding is used.
[[r2_buckets]]
binding = "ASSETS"
bucket_name = "REPLACE_WITH_CREATED_R2_BUCKET"

[vars]
# Replace with the HTTPS public domain configured for the R2 bucket.
ASSET_PUBLIC_BASE_URL = "https://REPLACE_WITH_R2_PUBLIC_DOMAIN"

# Set these as Worker secrets, never in this file or frontend JavaScript:
# npx wrangler secret put ADMIN_EMAIL
# npx wrangler secret put ADMIN_PASSWORD_HASH
# npx wrangler secret put SESSION_SECRET
# npx wrangler secret put ALLOWED_ORIGINS
# ALLOWED_ORIGINS must be exact origins, e.g. https://the-ark-spa.github.io
